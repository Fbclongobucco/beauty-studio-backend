# Perfil PROD. O ./stack.sh prod cria o .env.prod a partir deste arquivo e gera os segredos vazios.
# Depois preencha as URLs publicas, o CORS e as contas. Variaveis com "obrigatoria" impedem a subida quando vazias.
# Segredos: openssl rand -hex 32
IMAGE_TAG=prod

# ---- PostgreSQL (um banco e um usuario por servico) ----
# POSTGRES_PASSWORD: obrigatoria: superusuario postgres
POSTGRES_PASSWORD=
# BOOKING_DB_PASSWORD: obrigatoria
BOOKING_DB_PASSWORD=
# NOTIFICATION_DB_PASSWORD: obrigatoria
NOTIFICATION_DB_PASSWORD=
# EVOLUTION_DB_PASSWORD: obrigatoria; vai numa URI de conexao: use so letras e numeros
EVOLUTION_DB_PASSWORD=
DB_POOL_MAX_SIZE=10

# ---- RabbitMQ ----
RABBITMQ_USERNAME=beauty
# RABBITMQ_PASSWORD: obrigatoria
RABBITMQ_PASSWORD=

# ---- MinIO (fotos dos servicos) ----
MINIO_ROOT_USER=beauty
# MINIO_ROOT_PASSWORD: obrigatoria, 8+ caracteres
MINIO_ROOT_PASSWORD=

# ---- Evolution API (WhatsApp) ----
# EVOLUTION_API_KEY: obrigatoria: chave global da API
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=beauty-studio   # nome da instancia conectada ao numero do salao
# EVOLUTION_SERVER_URL: obrigatoria: URL de acesso a Evolution (ex.: http://localhost:8081 pelo tunel SSH)
EVOLUTION_SERVER_URL=
EVOLUTION_LOCAL_PORT=8081     # porta em 127.0.0.1 no servidor
NOTIFICATION_SEND_ENABLED=false    # envio suspenso (ver README); true exige o numero do salao conectado na Evolution
# SALON_WHATSAPP: WhatsApp do salao em E.164 (ex.: +5521968117976), vai nas mensagens de recusa e cancelamento
SALON_WHATSAPP=

# ---- Sessao do painel e contas ----
# APP_JWT_SECRET: obrigatoria: 32+ caracteres aleatorios
APP_JWT_SECRET=
ADMIN_USERNAME=master
# ADMIN_PASSWORD: obrigatoria (o stack.sh gera uma senha)
ADMIN_PASSWORD=
# ADMIN_USERS: stefani:senha1;lorrayne:senha2;michele:senha3
ADMIN_USERS=
# APP_COOKIE_SECURE e sempre true no perfil prod
APP_COOKIE_SAME_SITE=Lax      # Lax: front e API no mesmo dominio (salao.com.br e api.salao.com.br)
# APP_COOKIE_DOMAIN: obrigatoria com o front na Vercel: o dominio comum aos dois (ex.: salao.com.br),
# para o front tambem ver a sessao do painel. O booking-service nao sobe sem ela nesse caso.
APP_COOKIE_DOMAIN=

# ---- Dominios, URLs e CORS ----
# Front na Vercel com dominio proprio (ex.: salao.com.br) e API nesta VPS (ex.: api.salao.com.br).
# O endereco *.vercel.app nao serve: a sessao do painel exige os dois no mesmo dominio.
# API_DOMAIN: obrigatoria: dominio da API; o Caddy emite o certificado HTTPS para ele (DNS A apontando para a VPS)
API_DOMAIN=
# APP_CORS_ALLOWED_ORIGINS: obrigatoria: origem do front (ex.: https://salao.com.br; varias separadas por virgula, ex.: com www)
APP_CORS_ALLOWED_ORIGINS=
# APP_PUBLIC_FRONT_URL: obrigatoria, https: endereco do front (ex.: https://salao.com.br)
APP_PUBLIC_FRONT_URL=
# APP_PUBLIC_MEDIA_URL: obrigatoria, https: endereco da API, base das fotos (ex.: https://api.salao.com.br)
APP_PUBLIC_MEDIA_URL=

# ---- JVM ----
APP_VIRTUAL_THREADS=true
JAVA_OPTS=-XX:MaxRAMPercentage=75

# ---- Proxy reverso ----
GATEWAY_TRUSTED_PROXIES=.*    # de quem o gateway aceita X-Forwarded-For existente
LOGIN_TRUSTED_PROXY_HOPS=2    # Caddy + gateway na frente do booking (padrao do perfil prod)
