# Perfil LOCAL. O ./stack.sh local cria o .env.local a partir deste arquivo e gera os segredos vazios.
# Variaveis com "obrigatoria" impedem a subida quando vazias. Segredos: openssl rand -hex 32
IMAGE_TAG=local

# ---- PostgreSQL (um banco e um usuario por servico) ----
# POSTGRES_PASSWORD: obrigatoria: superusuario postgres
POSTGRES_PASSWORD=
# BOOKING_DB_PASSWORD: obrigatoria
BOOKING_DB_PASSWORD=
# NOTIFICATION_DB_PASSWORD: obrigatoria
NOTIFICATION_DB_PASSWORD=
# EVOLUTION_DB_PASSWORD: obrigatoria; vai numa URI de conexao: use so letras e numeros
EVOLUTION_DB_PASSWORD=
DB_POOL_MAX_SIZE=10

# ---- RabbitMQ ----
RABBITMQ_USERNAME=beauty
# RABBITMQ_PASSWORD: obrigatoria
RABBITMQ_PASSWORD=

# ---- MinIO (fotos dos servicos) ----
MINIO_ROOT_USER=beauty
# MINIO_ROOT_PASSWORD: obrigatoria, 8+ caracteres
MINIO_ROOT_PASSWORD=

# ---- Evolution API (WhatsApp) ----
# EVOLUTION_API_KEY: obrigatoria: chave global da API
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=beauty-studio   # nome da instancia conectada ao numero do salao
EVOLUTION_SERVER_URL=http://localhost:8081
NOTIFICATION_SEND_ENABLED=false    # false: so registra a mensagem no log (desenvolvimento)
# SALON_WHATSAPP: WhatsApp do salao em E.164 (ex.: +5521968117976), vai nas mensagens de recusa e cancelamento
SALON_WHATSAPP=

# ---- Sessao do painel e contas ----
# APP_JWT_SECRET: obrigatoria: 32+ caracteres aleatorios
APP_JWT_SECRET=
ADMIN_USERNAME=master
# ADMIN_PASSWORD: vazio desabilita o master (o stack.sh gera uma senha)
ADMIN_PASSWORD=
# ADMIN_USERS: stefani:senha1;lorrayne:senha2;michele:senha3
ADMIN_USERS=
APP_COOKIE_SECURE=false       # true em producao (HTTPS)
APP_COOKIE_SAME_SITE=Lax      # None so com front e API em sites diferentes (exige Secure)

# ---- URLs e CORS ----
GATEWAY_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_PUBLIC_FRONT_URL=http://localhost:3000    # links do painel e do status do pedido nas mensagens
APP_PUBLIC_MEDIA_URL=http://localhost:8080    # URL publica do gateway, base das fotos (/media/...)

# ---- JVM ----
APP_VIRTUAL_THREADS=true
JAVA_OPTS=-XX:MaxRAMPercentage=75

# ---- Proxy reverso (opcional) ----
GATEWAY_TRUSTED_PROXIES=.*    # de quem o gateway aceita X-Forwarded-For existente
LOGIN_TRUSTED_PROXY_HOPS=1    # 2 se houver um proxy reverso (HTTPS) na frente do gateway
