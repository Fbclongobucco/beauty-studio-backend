# Perfil ENXUTO (servidor de 1 GB). O ./stack.sh lite cria o .env.lite a partir deste arquivo e gera os segredos vazios.
# Depois preencha os dominios, as URLs e as contas. Segredos: openssl rand -hex 32
IMAGE_TAG=lite

# ---- PostgreSQL e MinIO ----
POSTGRES_PASSWORD=
BOOKING_DB_PASSWORD=
MINIO_ROOT_USER=beauty
MINIO_ROOT_PASSWORD=
DB_POOL_MAX_SIZE=5

# ---- Sessao do painel e contas ----
APP_JWT_SECRET=
ADMIN_USERNAME=master
# ADMIN_PASSWORD: obrigatoria (o stack.sh gera uma senha)
ADMIN_PASSWORD=
# ADMIN_USERS: contas das profissionais, ex.: stefani:senha1;lorrayne:senha2;michele:senha3
ADMIN_USERS=
APP_COOKIE_SAME_SITE=Lax

# ---- Dominios (front na Vercel, API nesta VPS; os dois no mesmo dominio) ----
# API_DOMAIN: dominio da API; o Caddy emite o HTTPS para ele (DNS A apontando para a VPS). Ex.: api.salao.com.br
API_DOMAIN=
# APP_COOKIE_DOMAIN: dominio comum ao front e a API, ex.: salao.com.br
APP_COOKIE_DOMAIN=
# APP_CORS_ALLOWED_ORIGINS: origem do front, ex.: https://salao.com.br (varias separadas por virgula)
APP_CORS_ALLOWED_ORIGINS=
# APP_PUBLIC_FRONT_URL: ex.: https://salao.com.br
APP_PUBLIC_FRONT_URL=
# APP_PUBLIC_MEDIA_URL: endereco da API, base das fotos, ex.: https://api.salao.com.br
APP_PUBLIC_MEDIA_URL=
